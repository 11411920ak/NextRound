# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/nextround

# JWT secret
JWT_SECRET=your_super_secret_jwt_key_change_me

# Google Gemini API key (FREE Tier: 15 req/min, 1,500 req/day)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API key (Optional alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# Email verification (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords → create an app password
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Google OAuth 2.0 Client ID
# Get it from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server port
PORT=5000

# Environment
NODE_ENV=development
